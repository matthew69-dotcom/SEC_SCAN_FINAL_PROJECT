# ──────────────────── Python ────────────────────
# Virtual environments — every developer creates their own
.venv/
venv/
env/
ENV/

# Bytecode + caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ──────────────────── Node / Frontend ────────────────────
node_modules/
frontend/dist/
frontend/build/
.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────── Environment / Secrets ────────────────────
# Each developer keeps their own .env with their own API keys.
.env
.env.local
.env.*.local
*.pem
*.key

# ──────────────────── Editors / IDEs ────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ──────────────────── OS ────────────────────
.DS_Store
Thumbs.db
Desktop.ini

