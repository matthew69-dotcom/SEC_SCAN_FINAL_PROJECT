# Copy to .env and fill in. .env is gitignored — never commit it.

# Required only for AI summaries (Full scan mode). Without it the AI
# falls back to a local template (generated_by_ai=False).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# sqlite:///./dev.db (default, local) or postgresql://user:pw@host:5432/db
# Async driver (aiosqlite/asyncpg) is picked automatically from the scheme.
DATABASE_URL=sqlite:///./dev.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
